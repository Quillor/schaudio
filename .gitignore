# ---- generated audio + extracted book text -------------------------------
# Derived artefacts, not source: every file under app/books/ is reproducible
# from the source PDFs via tools/ingest.py + tools/narrate.py. Excluded because
# it is (a) hundreds of MB and growing, and (b) copyrighted book content that
# does not belong in a code repository.
app/books/*/audio/
app/books/*/manifests/
app/books/*/book.json
app/books/*/cover.png

# ---- environments and build output ---------------------------------------
.venv-tts/
.venv-piper/
.piper-voices/
node_modules/
.vercel/
ios/build/
ios/Schaudio.xcodeproj/      # generated by xcodegen from project.yml
DerivedData/
*.xcuserstate

# ---- run state -----------------------------------------------------------
run/claims/
run/*.log
overnight.log
*.log

# ---- macOS ---------------------------------------------------------------
.DS_Store
